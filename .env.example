# ==========================================
# Forever E-Commerce Storefront - environment template
# NEXT_PUBLIC_* values are inlined at build time; set them before `npm run build`.
# ==========================================

# Backend REST API URL  [required for production builds]
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Admin portal URL (cross-app link)  [required for production builds]
NEXT_PUBLIC_ADMIN_URL=http://localhost:5174

# Razorpay public key id (safe to expose; the secret stays on the backend)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
